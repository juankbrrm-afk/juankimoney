# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it stays out of git (see .gitignore).

# Public hostname n8n will be reached at (from the Cloudflare Tunnel step)
N8N_HOST=n8n.tudominio.com
WEBHOOK_URL=https://n8n.tudominio.com/

# Login for the n8n editor UI itself
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_to_something_strong

# Random 32+ character string used to encrypt stored credentials.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me

# From Cloudflare Zero Trust → Networks → Tunnels → (create tunnel) → token
CLOUDFLARE_TUNNEL_TOKEN=change_me
