{
  "name": "MONÉA — Flujo 2: Filtrar, Pricear y Publicar Productos",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 9 }] }
      },
      "id": "trigger-weekly",
      "name": "Lunes 9am (weekly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0]
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "PLACEHOLDER_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "mode": "name", "value": "candidatos" },
        "options": {}
      },
      "id": "read-candidates",
      "name": "Google Sheets: Leer Candidatos",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [220, 0],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(i => i.json.status === 'pending');"
      },
      "id": "filter-pending",
      "name": "Filtrar status = pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5\",\n  max_tokens: 900,\n  messages: [{\n    role: \"user\",\n    content: `Eres el equipo de producto de MONÉA, marca de moda femenina 'boutique / lujo accesible'. Evalúa este producto candidato de dropshipping:\\n\\nTítulo original: ${$json.title}\\nCategoría: ${$json.category}\\nCosto proveedor: $${$json.cost}\\nDescripción original: ${$json.description || 'N/A'}\\n\\nDevuelve SOLO un JSON válido (sin markdown) con esta forma exacta:\\n{\"fit_score\": <1-10, qué tanto encaja con el posicionamiento boutique/lujo accesible de MONÉA>, \"reason\": \"<1 frase>\", \"title\": \"<título reescrito, editorial, en inglés>\", \"description_html\": \"<descripción en HTML simple (p, ul/li), tono editorial confiado, en inglés, 2-3 frases + bullets de detalles>\"}`\n  }]\n}) }}"
      },
      "id": "claude-evaluate",
      "name": "Claude: Evaluar y Escribir Copy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [660, 0],
      "credentials": {
        "anthropicApi": { "id": null, "name": "n8n credits", "__aiGatewayManaged": true }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.content && $json.content[0] && $json.content[0].text) || \"{}\";\nlet parsed = {};\ntry {\n  const start = raw.indexOf(\"{\");\n  const end = raw.lastIndexOf(\"}\");\n  parsed = JSON.parse(raw.slice(start, end + 1));\n} catch (e) { parsed = { fit_score: 0, reason: \"parse_error\", title: \"\", description_html: \"\" }; }\nconst src = $(\"Filtrar status = pending\").item.json;\nreturn { json: { ...src, ...parsed } };"
      },
      "id": "parse-claude",
      "name": "Parse Claude Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            { "leftValue": "={{ $json.fit_score }}", "rightValue": 7, "operator": { "type": "number", "operation": "gte" } }
          ]
        }
      },
      "id": "if-good-fit",
      "name": "IF: fit_score >= 7",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "jsCode": "// Fórmula de precio: costo x multiplicador, con piso/techo del rango objetivo $40-100\nconst MULTIPLIER = 6;\nconst MIN_PRICE = 40;\nconst MAX_PRICE = 100;\nlet price = $json.cost * MULTIPLIER;\nprice = Math.max(MIN_PRICE, Math.min(MAX_PRICE, price));\nprice = Math.floor(price) - 0.01 + 1; // termina en x9.99 estilo retail\nreturn [{ json: { ...$json, sale_price: Math.round(price * 100) / 100 } }];"
      },
      "id": "calc-price",
      "name": "Calcular Precio de Venta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "resource": "product",
        "operation": "create",
        "title": "={{ $json.title }}",
        "additionalFields": {
          "bodyHtml": "={{ $json.description_html }}",
          "productType": "={{ $json.category }}",
          "vendor": "MONÉA",
          "status": "active"
        }
      },
      "id": "shopify-create-product",
      "name": "Shopify: Crear Producto",
      "type": "n8n-nodes-base.shopify",
      "typeVersion": 1,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "PLACEHOLDER_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "mode": "name", "value": "candidatos" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["product_url"],
          "value": {
            "product_url": "={{ $('Parse Claude Output').item.json.product_url }}",
            "status": "published",
            "shopify_product_id": "={{ $json.id }}",
            "sale_price": "={{ $('Calcular Precio de Venta').item.json.sale_price }}"
          }
        },
        "options": {}
      },
      "id": "log-published",
      "name": "Google Sheets: Marcar Publicado",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1760, -100],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "PLACEHOLDER_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "mode": "name", "value": "candidatos" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["product_url"],
          "value": {
            "product_url": "={{ $json.product_url }}",
            "status": "rejected",
            "reason": "={{ $json.reason }}"
          }
        },
        "options": {}
      },
      "id": "log-rejected",
      "name": "Google Sheets: Marcar Rechazado",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1320, 120],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER", "name": "Google Sheets account" }
      }
    }
  ],
  "connections": {
    "Lunes 9am (weekly)": { "main": [[{ "node": "Google Sheets: Leer Candidatos", "type": "main", "index": 0 }]] },
    "Google Sheets: Leer Candidatos": { "main": [[{ "node": "Filtrar status = pending", "type": "main", "index": 0 }]] },
    "Filtrar status = pending": { "main": [[{ "node": "Claude: Evaluar y Escribir Copy", "type": "main", "index": 0 }]] },
    "Claude: Evaluar y Escribir Copy": { "main": [[{ "node": "Parse Claude Output", "type": "main", "index": 0 }]] },
    "Parse Claude Output": { "main": [[{ "node": "IF: fit_score >= 7", "type": "main", "index": 0 }]] },
    "IF: fit_score >= 7": {
      "main": [
        [{ "node": "Calcular Precio de Venta", "type": "main", "index": 0 }],
        [{ "node": "Google Sheets: Marcar Rechazado", "type": "main", "index": 0 }]
      ]
    },
    "Calcular Precio de Venta": { "main": [[{ "node": "Shopify: Crear Producto", "type": "main", "index": 0 }]] },
    "Shopify: Crear Producto": { "main": [[{ "node": "Google Sheets: Marcar Publicado", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
