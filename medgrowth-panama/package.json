{
  "name": "medgrowth-panama",
  "private": true,
  "version": "0.1.0",
  "description": "MedGrowth Panama — AI patient acquisition platform for private clinics.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @medgrowth/db build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @medgrowth/db db:generate",
    "db:push": "pnpm --filter @medgrowth/db db:push",
    "db:seed": "pnpm --filter @medgrowth/db db:seed"
  }
}
