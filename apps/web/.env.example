# Motor de IA (obligatorio para respuestas reales del concierge; sin esto, /api/chat
# responde con un modo de demostración que usa los datos semilla sin llamar a Claude)
ANTHROPIC_API_KEY=

# Fase 2+: base de datos real (Supabase). Sin esto, la app usa el dataset semilla
# en lib/data/places.ts como stand-in de la tabla `places`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Integraciones (ver docs/panama-ai/04-apis.md) — no requeridas para correr el MVP local
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=

# Pagos — Yappy (reservas/checkout local) + PagueloFacil (suscripciones recurrentes,
# tarjeta internacional). Ver lib/payments/. No usamos Stripe (decisión explícita del negocio).
YAPPY_MERCHANT_ID=
YAPPY_SECRET_KEY=
PAGUELOFACIL_API_KEY=
PAGUELOFACIL_CCLW_TOKEN=
