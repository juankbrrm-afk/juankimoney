# ─────────────────────────────────────────────────────────────
# Cantara — configuración
# Copia a .env y ajusta. El proyecto ARRANCA TAL CUAL, sin
# ninguna API key: todos los proveedores de IA caen al adaptador
# `local`, que produce audio sintetizado de forma determinista.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Servicios ────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=postgresql://cantara:cantara@localhost:5432/cantara?schema=public

# ── Redis / colas ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Almacenamiento de objetos (S3 / MinIO / R2) ──────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cantara-audio
S3_ACCESS_KEY_ID=cantara
S3_SECRET_ACCESS_KEY=cantara-dev-secret
S3_FORCE_PATH_STYLE=true
# URL pública del bucket si sirves por CDN (opcional)
# S3_PUBLIC_URL=https://cdn.tudominio.com

# ── Sesiones ─────────────────────────────────────────────────
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-32-bytes-hex-en-produccion-0123456789abcdef
SESSION_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────
# Proveedores de IA
# Valores admitidos por cada puerto. `local` no necesita claves.
# ─────────────────────────────────────────────────────────────

# local | anthropic
LYRICS_PROVIDER=local
# local | elevenlabs | suno
MUSIC_PROVIDER=local
# local | rvc | seedvc      (entrenamiento + conversión de voz)
VOICE_PROVIDER=local
# local | demucs | native   (`native` usa los stems del motor musical)
STEMS_PROVIDER=local
# local | matchering | landr | dolby | loudnorm
MASTERING_PROVIDER=local

# ── Claves (solo si cambias algún proveedor arriba) ──────────
# ── Para que cante con TU voz (ver GUIA-PERSONAL.md) ─────────
# VOICE_PROVIDER=rvc
# STEMS_PROVIDER=demucs
# REPLICATE_API_TOKEN=r8_...
# RVC_TRAIN_MODEL=replicate/train-rvc-model
# RVC_INFER_MODEL=pseudoram/rvc-v2
# DEMUCS_MODEL=ryan5453/demucs
# SEEDVC_MODEL=          # alternativa zero-shot, sin entrenamiento

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ELEVENLABS_API_KEY=
# REPLICATE_API_TOKEN=          # RVC, seed-vc, Demucs, Matchering
# LANDR_API_KEY=
# DOLBY_API_KEY=

# ── Límites del producto ─────────────────────────────────────
VOICE_MIN_SECONDS=120
VOICE_MAX_SECONDS=600
UPLOAD_MAX_BYTES=52428800
SONG_MAX_SECONDS=240
# Cubre entrenamiento + canción + regeneración (ver packages/shared/src/credits.ts)
FREE_SIGNUP_CREDITS=180
