<section class="section">
  <div class="wrap" data-reveal>
    <div class="philosophy">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <p>{{ section.settings.heading }} {{ section.settings.body }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We don't chase trends." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "We create timeless essentials designed to live inside your wardrobe for years — tailored silhouettes, premium fabrics, and a quiet confidence that never needs to raise its voice." }
  ],
  "presets": [{ "name": "Philosophy" }]
}
{% endschema %}
