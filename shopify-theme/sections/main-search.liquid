<div class="wrap" style="padding-top:128px;padding-bottom:96px">
  <form action="{{ routes.search_url }}" method="get" style="max-width:640px;margin:0 auto">
    <div class="search-drawer__field" style="border-bottom:1px solid rgba(0,0,0,0.15);padding-bottom:16px">
      <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" style="font-size:28px">
      <button type="submit" class="eyebrow">{{ 'general.search' | t }}</button>
    </div>
  </form>

  <div class="product-grid" style="margin-top:56px" data-reveal>
    {% for item in search.results %}
      {% if item.object_type == 'product' %}
        {% render 'product-card', product: item %}
      {% endif %}
    {% endfor %}
  </div>

  {% if search.performed and search.results_count == 0 %}
    <p style="text-align:center;color:var(--color-warmgray);margin-top:48px">{{ 'search.no_results' | t }}</p>
  {% endif %}
</div>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
