<section class="hero" id="hero">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x' }}
    {% elsif section.settings.image %}
      {{ section.settings.image | image_url: width: 1920 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    {% else %}
      <div class="editorial-image" style="height:100%"></div>
    {% endif %}
  </div>
  <div class="hero__scrim"></div>

  <div class="hero__content">
    <span class="eyebrow hero__eyebrow" style="color:rgba(255,255,255,0.8)">{{ section.settings.eyebrow }}</span>
    <h1 class="hero__title">
      {% assign heading_lines = section.settings.heading | newline_to_br | split: '<br />' %}
      {% for line in heading_lines %}
        <span>{{ line | strip }}</span>
      {% endfor %}
    </h1>
    <div class="hero__cta">
      <a href="#collection" class="btn-outline btn-outline--light" data-cursor-hover>{{ section.settings.cta_label }}</a>
    </div>
  </div>

  <div class="hero__scroll">
    <span class="eyebrow" style="color:rgba(255,255,255,0.7)">Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

{% style %}
  .hero.is-ready .hero__eyebrow,
  .hero.is-ready .hero__title span,
  .hero.is-ready .hero__cta,
  .hero.is-ready .hero__scroll { opacity: 1; transform: translateY(0); }
  .hero.is-ready .hero__eyebrow { transition: opacity 1.1s var(--ease-luxury) 0.1s, transform 1.1s var(--ease-luxury) 0.1s; }
  .hero.is-ready .hero__title span { transition: opacity 1.3s var(--ease-luxury), transform 1.3s var(--ease-luxury); }
  .hero.is-ready .hero__title span:nth-child(1) { transition-delay: 0.3s; }
  .hero.is-ready .hero__title span:nth-child(2) { transition-delay: 0.42s; }
  .hero.is-ready .hero__cta { transition: opacity 1s var(--ease-luxury) 0.9s, transform 1s var(--ease-luxury) 0.9s; }
  .hero.is-ready .hero__scroll { transition: opacity 1.2s var(--ease-luxury) 1.2s; }
  .hero__media img, .hero__media video { transform: scale(1.12); transition: transform 2.6s var(--ease-luxury) 0.3s; }
  .hero.is-ready .hero__media img, .hero.is-ready .hero__media video { transform: scale(1); }
{% endstyle %}

{% schema %}
{
  "name": "Cinematic hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (fallback if no video)" },
    { "type": "video", "id": "video", "label": "Hero campaign video" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MONÉA — 2024" },
    { "type": "textarea", "id": "heading", "label": "Headline (line break = new line)", "default": "Designed for women\nwho move with confidence." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Discover" }
  ],
  "presets": [{ "name": "Cinematic hero" }]
}
{% endschema %}
