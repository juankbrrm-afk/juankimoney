<div class="wrap" style="padding-top:128px;padding-bottom:96px">
  <div style="max-width:640px;margin:0 auto 56px;text-align:center">
    <span class="eyebrow">Collections</span>
    <h1 style="margin-top:16px;font-size:clamp(1.9rem,5vw,3rem)">Shop by edit.</h1>
  </div>
  <div class="product-grid" data-reveal>
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a href="{{ collection.url }}" data-cursor-hover>
          <div class="editorial-image editorial-image--45">
            {% if collection.image %}{{ collection.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}
          </div>
          <p class="product-card__name">{{ collection.title }}</p>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</div>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
