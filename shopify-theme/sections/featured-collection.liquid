<section class="section{% if section.settings.background == 'cream' %} section--cream{% endif %}">
  <div class="wrap">
    <div class="section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        <h2 style="margin-top:16px">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.collection %}
        <a href="{{ section.settings.collection.url }}" class="section-link" data-cursor-hover>View All</a>
      {% endif %}
    </div>

    <div class="product-grid product-grid--{{ section.settings.columns }}" data-reveal>
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces our clients return to." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "default": 5 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [
      { "value": "3", "label": "3" },
      { "value": "5", "label": "5" }
    ], "default": "3" },
    { "type": "select", "id": "background", "label": "Background", "options": [
      { "value": "ivory", "label": "Ivory" },
      { "value": "cream", "label": "Cream" }
    ], "default": "ivory" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
