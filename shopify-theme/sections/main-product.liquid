{% liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
%}
<div class="product-page">
  <div class="product-gallery" data-product-gallery>
    <div class="product-gallery__track" data-gallery-track>
      {% for image in product.images %}
        {% assign loading_attr = 'lazy' %}
        {% if forloop.first %}{% assign loading_attr = 'eager' %}{% endif %}
        <div class="product-gallery__slide editorial-image">
          {{ image | image_url: width: 1200 | image_tag: loading: loading_attr, alt: product.title }}
        </div>
      {% endfor %}
      {% if product.images.size == 0 %}
        <div class="product-gallery__slide editorial-image" style="aspect-ratio:4/5"></div>
      {% endif %}
    </div>
    {% if product.images.size > 1 %}
      <button type="button" class="product-gallery__arrow product-gallery__arrow--prev" data-gallery-prev data-cursor-hover aria-label="Previous">←</button>
      <button type="button" class="product-gallery__arrow product-gallery__arrow--next" data-gallery-next data-cursor-hover aria-label="Next">→</button>
      <div class="product-gallery__counter" data-gallery-counter>1 / {{ product.images.size }}</div>
    {% endif %}
  </div>

  <div class="product-info">
    <div class="product-info__inner">
      <span class="eyebrow">{{ product.type }}</span>
      <h1>{{ product.title }}</h1>
      <p class="product-info__price">
        <span class="compare" data-variant-compare {% unless current_variant.compare_at_price > current_variant.price %}style="display:none"{% endunless %}>
          {{ current_variant.compare_at_price | money_without_trailing_zeros }}
        </span>
        <span data-variant-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
      </p>

      {% if product.description != blank %}
        <div class="product-info__desc">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product, id: 'product-form', class: 'product-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <script type="application/json" data-variants-json>{{ product.variants | json }}</script>

        {% for option in product.options_with_values %}
          <div class="option-block" data-option-index="{{ forloop.index0 }}">
            <div class="option-block__head">
              <span class="eyebrow">{{ option.name }}{% if option.name == 'Size' %} — {{ current_variant.title }}{% endif %}</span>
              {% if option.name == 'Size' %}
                <button type="button" data-size-guide-open data-cursor-hover style="font-size:11px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-warmgray);text-decoration:underline;text-underline-offset:4px">{{ 'product.size_guide' | t }}</button>
              {% endif %}
            </div>
            <div class="option-swatches">
              {% for value in option.values %}
                <button
                  type="button"
                  class="swatch"
                  data-option-value="{{ value | escape }}"
                  data-selected="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                  data-cursor-hover
                >{{ value }}</button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <div class="qty-row">
          <span class="eyebrow">{{ 'general.quantity' | t }}</span>
          <div class="qty-stepper" style="font-size:14px">
            <button type="button" data-qty-minus data-cursor-hover>−</button>
            <input type="number" name="quantity" value="1" min="1" data-qty-input style="width:32px;text-align:center;background:transparent;border:none">
            <button type="button" data-qty-plus data-cursor-hover>+</button>
          </div>
        </div>

        <div class="product-actions">
          <button
            type="submit"
            class="btn-solid"
            data-cursor-hover
            data-label-available="{{ 'product.add_to_cart' | t }}"
            data-label-soldout="{{ 'product.sold_out' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >{% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
          <button type="button" class="wishlist-toggle" data-wishlist-toggle="{{ product.id }}" data-active="false" data-cursor-hover aria-label="{{ 'general.save_to_wishlist' | t }}">♡</button>
        </div>
      {% endform %}

      <div class="accordion">
        <div class="accordion-item">
          <button type="button" class="accordion-item__btn">{{ 'product.size_chart' | t }}<span class="accordion-item__plus">+</span></button>
          <div class="accordion-item__panel">
            <div>
              <table class="size-chart-table">
                <thead><tr><th>{{ 'product.size_th' | t }}</th><th>{{ 'product.bust_th' | t }}</th><th>{{ 'product.waist_th' | t }}</th><th>{{ 'product.hip_th' | t }}</th></tr></thead>
                <tbody>
                  <tr><td>XS</td><td>32</td><td>24</td><td>34</td></tr>
                  <tr><td>S</td><td>34</td><td>26</td><td>36</td></tr>
                  <tr><td>M</td><td>36</td><td>28</td><td>38</td></tr>
                  <tr><td>L</td><td>38</td><td>30</td><td>40</td></tr>
                  <tr><td>XL</td><td>40</td><td>32</td><td>42</td></tr>
                </tbody>
              </table>
              <p style="margin-top:12px">{{ 'product.size_guide_note' | t }}</p>
            </div>
          </div>
        </div>
        <div class="accordion-item">
          <button type="button" class="accordion-item__btn">{{ 'product.shipping' | t }}<span class="accordion-item__plus">+</span></button>
          <div class="accordion-item__panel"><div><p>{{ 'product.shipping_text' | t }}</p></div></div>
        </div>
        <div class="accordion-item">
          <button type="button" class="accordion-item__btn">{{ 'product.returns' | t }}<span class="accordion-item__plus">+</span></button>
          <div class="accordion-item__panel"><div><p>{{ 'product.returns_text' | t }}</p></div></div>
        </div>
        {% if product.metafields.custom.materials != blank %}
        <div class="accordion-item">
          <button type="button" class="accordion-item__btn">{{ 'product.materials' | t }}<span class="accordion-item__plus">+</span></button>
          <div class="accordion-item__panel"><div><p>{{ product.metafields.custom.materials }}</p></div></div>
        </div>
        {% endif %}
        <div class="accordion-item">
          <button type="button" class="accordion-item__btn">{{ 'product.care' | t }}<span class="accordion-item__plus">+</span></button>
          <div class="accordion-item__panel"><div><p>{{ 'product.care_text' | t }}</p></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

{% assign related_collection = product.collections.first %}
{% if related_collection %}
<section class="section" style="border-top:1px solid rgba(0,0,0,0.1)">
  <div class="wrap">
    <p class="eyebrow" style="text-align:center">{{ 'product.complete_the_look' | t }}</p>
    <div class="product-grid" style="margin-top:40px;grid-template-columns:repeat(2,1fr)">
      {% assign shown = 0 %}
      {% for related in related_collection.products %}
        {% if related.id != product.id and shown < 4 %}
          {% render 'product-card', product: related %}
          {% assign shown = shown | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<div class="size-guide-modal" data-size-guide-modal>
  <div class="size-guide-modal__panel">
    <div class="size-guide-modal__head">
      <span class="eyebrow">{{ 'product.size_guide' | t }}</span>
      <button type="button" data-size-guide-close data-cursor-hover class="eyebrow">{{ 'general.close' | t }}</button>
    </div>
    <table>
      <thead><tr><th>{{ 'product.size_th' | t }}</th><th>{{ 'product.bust_th' | t }}</th><th>{{ 'product.waist_th' | t }}</th><th>{{ 'product.hip_th' | t }}</th></tr></thead>
      <tbody>
        <tr><td>XS</td><td>32</td><td>24</td><td>34</td></tr>
        <tr><td>S</td><td>34</td><td>26</td><td>36</td></tr>
        <tr><td>M</td><td>36</td><td>28</td><td>38</td></tr>
        <tr><td>L</td><td>38</td><td>30</td><td>40</td></tr>
        <tr><td>XL</td><td>40</td><td>32</td><td>42</td></tr>
      </tbody>
    </table>
    <p class="size-guide-modal__note">{{ 'product.size_guide_note' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": []
}
{% endschema %}
