<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {{ page_title }}{% if page_title contains settings.brand_name %}{% else %} — {{ settings.brand_name }}{% endif %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="{{ settings.brand_descriptor | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&display=swap" rel="stylesheet">
    {{ 'theme.css.liquid' | asset_url | stylesheet_tag }}
  </head>
  <body data-template="{{ template.name }}">
    <div class="loading-screen" aria-hidden="true">
      <span class="loading-screen__mark">{{ settings.brand_name }}</span>
    </div>

    {% section 'header' %}
    {% render 'menu-drawer' %}
    {% render 'search-drawer' %}
    {% render 'cart-drawer' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script>
      window.MONEA_I18N = {
        emptyHeading: {{ 'cart.empty_heading' | t | json }},
        emptyBody: {{ 'cart.empty_body' | t | json }},
        noResults: {{ 'search.no_results' | t | json }},
        shopUrl: {{ routes.all_products_collection_url | json }},
        remove: {{ 'general.remove' | t | json }},
        continueShopping: {{ 'general.continue_shopping' | t | json }},
        subtotal: {{ 'general.subtotal' | t | json }},
        checkout: {{ 'general.checkout' | t | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
